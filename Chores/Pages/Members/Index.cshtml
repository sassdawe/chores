@page
@model IndexModel
@inject UiTranslationService T
@{
    ViewData["Title"] = T["spaces.title"];
}

<h2 class="mb-3">@T["spaces.title"]</h2>

<div class="row g-4">
    <div class="col-md-5">
        <h5>@T["spaces.yourSpaces"]</h5>
        @if (Model.Spaces.Any())
        {
            <div class="list-group mb-3">
                @foreach (var space in Model.Spaces)
                {
                    <a asp-page="/Members/Index"
                       asp-route-householdId="@space.HouseholdId"
                       class="list-group-item list-group-item-action @(space.HouseholdId == Model.SelectedHouseholdId ? "active" : string.Empty)">
                        @space.Household.Name
                        @if (space.IsOwner)
                        {
                            <span class="badge text-bg-secondary ms-1">@T["spaces.owner"]</span>
                        }
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted">@T["spaces.noSpaces"]</p>
        }

        <h5>@T["spaces.create"]</h5>
        <form method="post" asp-page-handler="CreateSpace">
            <div class="input-group mb-1">
                <input name="SpaceName" class="form-control" placeholder="@T["spaces.spacePlaceholder"]" value="@Model.SpaceName" />
                <button type="submit" class="btn btn-primary">@T["common.create"]</button>
            </div>
            <span asp-validation-for="SpaceName" class="text-danger"></span>
        </form>
    </div>

    <div class="col-md-7">
        <h5>@(Model.SelectedHouseholdName ?? T["spaces.title"]) @T["spaces.membersOf"]</h5>

        @if (Model.CanInviteMembers)
        {
            <form method="post" asp-page-handler="RenameSpace" asp-route-householdId="@Model.SelectedHouseholdId" class="mb-4" style="max-width:400px;">
                <label for="RenameSpaceName" class="form-label">@T["spaces.displayName"]</label>
                <div class="input-group mb-1">
                    <input id="RenameSpaceName"
                           name="RenameSpaceName"
                           class="form-control"
                           value="@(string.IsNullOrWhiteSpace(Model.RenameSpaceName) ? Model.SelectedHouseholdName : Model.RenameSpaceName)" />
                    <button type="submit" class="btn btn-outline-primary">@T["spaces.rename"]</button>
                </div>
                <span asp-validation-for="RenameSpaceName" class="text-danger"></span>
            </form>
        }

        <div style="max-width:400px;">
            @if (Model.Members.Any())
            {
                <ul class="list-group mb-4">
                    @foreach (var member in Model.Members)
                    {
                        <li class="list-group-item">
                            @member.User.LoginName
                            @if (member.IsOwner)
                            {
                                <span class="badge text-bg-secondary ms-1">@T["spaces.owner"]</span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">@T["spaces.noMembers"]</p>
            }

            @if (Model.CanInviteMembers)
            {
                <h5>@T["spaces.inviteMember"]</h5>

                @if (!string.IsNullOrEmpty(Model.InviteResult))
                {
                    <div class="alert alert-info py-2">@Model.InviteResult</div>
                }

                <form method="post" asp-page-handler="Invite" asp-route-householdId="@Model.SelectedHouseholdId">
                    <input type="hidden" name="SelectedHouseholdId" value="@Model.SelectedHouseholdId" />
                    <div class="input-group mb-1">
                        <input name="InviteLoginName" class="form-control" placeholder="@T["spaces.loginName"]" value="@Model.InviteLoginName" />
                        <button type="submit" class="btn btn-primary">@T["spaces.invite"]</button>
                    </div>
                    <span asp-validation-for="InviteLoginName" class="text-danger"></span>
                </form>
                <p class="text-muted small mt-2 mb-0">
                    @T["spaces.inviteExpiry"]
                </p>
            }
            else
            {
                <p class="text-muted mb-0">@T["spaces.onlyOwnerInvite"]</p>
            }
        </div>
    </div>
</div>
