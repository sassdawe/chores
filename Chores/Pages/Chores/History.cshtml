@page "{id:int}"
@model HistoryModel
@inject UiTranslationService T
@{
    ViewData["Title"] = $"History – {Model.Chore.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Model.Chore.Name</h2>
    <a href="@Model.BuildManageChoresPath()" class="btn btn-outline-secondary btn-sm">@T["history.backToChores"]</a>
</div>

<p class="text-muted">@T["history.schedule"] @Model.Chore.Schedule.ToLocalizedLabel(T)</p>

@if (!Model.Entries.Any())
{
    <p class="text-muted">@T["history.noCompletions"]</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@T["history.when"]</th>
                <th>@T["history.by"]</th>
                <th>@T["history.onSchedule"]</th>
                <th>@T["history.skipped"]</th>
        </thead>
        <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td>@entry.Record.CompletedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>@entry.Record.CompletedByUser.LoginName</td>
                    <td>
                        @if (entry.Adherence is null)
                        {
                            <span class="badge bg-white border text-dark">@T["history.firstCompletion"]</span>
                        }
                        else if (entry.Adherence.Status == AdherenceStatus.AdHoc)
                        {
                            <span class="badge text-bg-secondary">@T["adherence.adHoc"]</span>
                        }
                        else if (entry.Adherence.Status == AdherenceStatus.OnTime)
                        {
                            <span class="badge bg-success">@T["adherence.onTime"]</span>
                        }
                        else if (entry.Adherence.Status == AdherenceStatus.DueSoon)
                        {
                            var badgeClass = ScheduleAdherenceService.ToBadgeClass(Model.Chore.Schedule, entry.Adherence);
                            var badgeText = ScheduleAdherenceService.ToDisplayText(Model.Chore.Schedule, entry.Adherence, T);

                            <span class="badge @badgeClass">@badgeText</span>
                        }
                        else if (entry.Adherence.Status == AdherenceStatus.DueToday)
                        {
                            <span class="badge bg-success">@T["history.onDueDate"]</span>
                        }
                        else if (entry.Adherence.DaysOverdue == 1)
                        {
                            <span class="badge bg-warning text-dark">@T["history.dayLate"]</span>
                        }
                        else if (entry.Adherence.DaysOverdue == 2)
                        {
                            <span class="badge" style="background-color: #fd7e14; color: #fff;">@string.Format(T["history.daysLate"], 2)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@string.Format(T["history.daysLate"], entry.Adherence.DaysOverdue)</span>
                        }
                    </td>
                    <td>
                        @if (entry.Record.IsSkipped)
                        {
                            <span class="badge bg-warning text-dark">@T["history.skipped"]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted small">@string.Format(T["history.totalCompletions"], Model.Entries.Count)</p>
}
