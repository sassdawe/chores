@page
@model EditModel
@inject UiTranslationService T
@{
    ViewData["Title"] = T["chores.editTitle"];
}

<div style="max-width:480px;">
    <h2 class="mb-3">@T["chores.editTitle"]</h2>
    @if (!string.IsNullOrEmpty(Model.HouseholdName))
    {
        <p class="text-muted">@T["chores.spaceColon"] @Model.HouseholdName</p>
    }

    <form method="post">
        @if (Model.LabelId.HasValue)
        {
            <input type="hidden" asp-for="LabelId" />
        }
        <input type="hidden" name="ChoreId" value="@Model.ChoreId" />
        <div class="mb-3">
            <label for="Name" class="form-label">@T["chores.choreName"]</label>
            <input id="Name" name="Name" class="form-control" value="@Model.Name" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label for="Schedule" class="form-label">@T["chores.schedule"]</label>
            <select id="Schedule" name="Schedule" class="form-select">
                @foreach (var s in ScheduleExtensions.GetSelectableSchedules())
                {
                    <option value="@s" selected="@(s == Model.Schedule ? "selected" : null)">@s.ToLocalizedLabel(T)</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@T["chores.labels"]</label>
            @if (Model.AvailableLabels.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var label in Model.AvailableLabels)
                    {
                        <label class="d-flex align-items-center gap-1" style="cursor:pointer;">
                            <input type="checkbox" name="SelectedLabelIds" value="@label.Id"
                                   checked="@(Model.SelectedLabelIds.Contains(label.Id) ? "checked" : null)" />
                            <span class="badge" style="background-color:@label.Color; color:@label.GetAccessibleTextColor();">@label.Name</span>
                        </label>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small">@T["chores.noLabels"] <a asp-page="/Labels/Create">@T["chores.createLabel"]</a></p>
            }
        </div>
        <button type="submit" class="btn btn-primary me-2">@T["common.save"]</button>
        <a href="@Model.BuildMovePath()" class="btn btn-outline-warning me-2">@T["chores.move"]</a>
        <a href="@Model.BuildManageChoresPath()" class="btn btn-outline-secondary">@T["common.cancel"]</a>
    </form>
</div>
