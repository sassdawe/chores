@page
@model CompleteModel
@inject UiTranslationService T
@{
    ViewData["Title"] = T["complete.title"];
}

<div style="max-width:480px; margin:40px auto; text-align:center;">
    <h2 class="mb-3">@Model.Chore.Name</h2>
    @if (Model.LastCompletionAdherence is not null)
    {
        var lastCompletionBadgeClass = ScheduleAdherenceService.ToBadgeClass(Model.Chore.Schedule, Model.LastCompletionAdherence);
        var lastCompletionStatusText = ScheduleAdherenceService.ToDisplayText(Model.Chore.Schedule, Model.LastCompletionAdherence, T);

        <div class="mb-4">
            <div class="text-muted small mb-2">@T["complete.lastCompletionStatus"]</div>
            <span class="badge @lastCompletionBadgeClass fs-6">@lastCompletionStatusText</span>
            <div class="text-muted small mt-2">
                @if (Model.LastCompletedUtc.HasValue)
                {
                    <span>@T["complete.lastCompleted"] @Model.LastCompletedUtc.Value.ToLocalTime().ToString("g")</span>
                }
                else
                {
                    <span>@T["complete.noCompletionYet"]</span>
                }
            </div>
        </div>
    }

    <p class="text-muted mb-4">@T["complete.whenDone"]</p>

    <form method="post" asp-page-handler="Yesterday" asp-route-id="@Model.Chore.Id">
        @if (Model.LabelId.HasValue)
        {
            <input type="hidden" asp-for="LabelId" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.Sort))
        {
            <input type="hidden" asp-for="Sort" />
        }
        @foreach (var householdId in Model.HouseholdIds)
        {
            <input type="hidden" name="HouseholdIds" value="@householdId" />
        }
        <div class="mb-3">
            <button type="submit" class="btn btn-outline-success btn-lg w-100">
                @T["complete.doneYesterday"]
            </button>
        </div>
    </form>

    <form method="post" asp-page-handler="" asp-route-id="@Model.Chore.Id">
        @if (Model.LabelId.HasValue)
        {
            <input type="hidden" asp-for="LabelId" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.Sort))
        {
            <input type="hidden" asp-for="Sort" />
        }
        @foreach (var householdId in Model.HouseholdIds)
        {
            <input type="hidden" name="HouseholdIds" value="@householdId" />
        }
        <div class="mb-4">
            <input type="datetime-local"
                   id="completedAt"
                   name="CompletedAt"
                   class="form-control form-control-lg text-center"
                   style="font-size:1.2rem; touch-action:manipulation;" />
        </div>
        <button type="submit" class="btn btn-success btn-lg me-2">@T["complete.markAsDone"]</button>
        <a href="@Model.BuildDashboardPath()" class="btn btn-outline-secondary btn-lg">@T["common.cancel"]</a>
    </form>

    <hr class="my-4" />

    <form method="post" asp-page-handler="Skip" asp-route-id="@Model.Chore.Id" id="skipForm">
        @if (Model.LabelId.HasValue)
        {
            <input type="hidden" asp-for="LabelId" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.Sort))
        {
            <input type="hidden" asp-for="Sort" />
        }
        @foreach (var householdId in Model.HouseholdIds)
        {
            <input type="hidden" name="HouseholdIds" value="@householdId" />
        }
        <p class="text-muted small mb-2">@T["complete.skipNote"]</p>
        <button type="submit" class="btn btn-outline-warning btn-lg w-100">
            @T["complete.skip"]
        </button>
    </form>
</div>

<script>
    (function () {
        const input = document.getElementById('completedAt');

        function toLocalDateTimeString(date) {
            const pad = n => String(n).padStart(2, '0');
            return date.getFullYear() + '-' +
                pad(date.getMonth() + 1) + '-' +
                pad(date.getDate()) + 'T' +
                pad(date.getHours()) + ':' +
                pad(date.getMinutes());
        }

        const now = new Date();
        const nowStr = toLocalDateTimeString(now);

        input.value = nowStr;   // default to right now
        input.max = nowStr;     // block future dates in the picker

        // Keep max updated every minute so it never falls behind
        setInterval(() => { input.max = toLocalDateTimeString(new Date()); }, 60000);
    })();

    document.getElementById('skipForm')?.addEventListener('submit', (e) => {
        if (!confirm('@T["complete.skip"]?')) {
            e.preventDefault();
        }
    });
</script>
