@page
@model IndexModel
@inject UiTranslationService T
@{
    ViewData["Title"] = T["labels.title"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@T["labels.title"]</h2>
    <a asp-page="Create" class="btn btn-primary btn-sm">@T["labels.addLabel"]</a>
</div>

@if (!Model.Labels.Any())
{
    <p class="text-muted">@T["labels.noLabels"]</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>@T["labels.name"]</th>
                <th>@T["labels.space"]</th>
                <th>@T["labels.color"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var label in Model.Labels)
            {
                <tr>
                    <td>
                        <span style="display:inline-block;width:14px;height:14px;border-radius:50%;background-color:@label.Color;margin-right:6px;vertical-align:middle;"></span>
                        @label.Name
                    </td>
                    <td>@label.Household.Name</td>
                    <td>@label.Color</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@label.Id" class="btn btn-outline-secondary btn-sm">@T["common.edit"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
